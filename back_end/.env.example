# =============================================================================
# ARTIVA — Backend : configuration de DÉVELOPPEMENT LOCAL
# =============================================================================
# Ce fichier est ignoré par Git (.gitignore). Voir .env.example pour le modèle.
# =============================================================================

PORT=3001

# -----------------------------------------------------------------------------
# Base de données — PostgreSQL lancé par docker compose (voir docker-compose.yml)
# Le port 5433 est celui exposé sur la machine hôte, pour ne pas entrer en
# conflit avec un éventuel PostgreSQL déjà installé sur le port 5432.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USER=artiva
DB_PASSWORD=artiva
DB_DATABASE=artiva
DB_SSL=false

# --- PRODUCTION (base distante) : à réactiver uniquement pour un déploiement ---
# DB_HOST=<hote-postgres-distant>
# DB_PORT=5432
# DB_USER=<utilisateur>
# DB_PASSWORD=<mot-de-passe>
# DB_DATABASE=<base>
# DB_SSL=true

# -----------------------------------------------------------------------------
# Sécurité
# -----------------------------------------------------------------------------
# Secret de développement : sans valeur en prod, à régénérer avant tout déploiement.
JWT_SECRET=change-moi-avec-une-valeur-aleatoire-longue
PASSWORD_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# Emails
# -----------------------------------------------------------------------------
# MAIL_TRANSPORT choisit où partent les emails :
#
#   mailpit  (par défaut) -> faux serveur SMTP local lancé par docker compose.
#                            Rien ne sort de la machine. On lit les messages,
#                            avec leur rendu HTML, sur http://localhost:8025
#                            C'est le mode recommandé : c'est le seul qui montre
#                            l'email tel que le client le recevra.
#   console               -> aucun envoi ; le contenu est écrit dans ce terminal.
#                            Utile si on ne veut pas lancer Docker.
#   brevo                 -> PRODUCTION : envoi réel via le relais SMTP Brevo.
MAIL_TRANSPORT=mailpit

# Adresse du serveur Mailpit. « localhost » convient quand le backend et Docker
# tournent sur la même machine. Mettre l'IP de la machine Docker sinon.
MAIL_HOST=localhost
MAIL_PORT=1025

# --- PRODUCTION (Brevo / SMTP) : renseigner et passer MAIL_TRANSPORT=brevo ----
# BREVO_SMTP_USER=<identifiant-smtp-brevo>
# BREVO_SMTP_PASS=<cle-smtp-brevo>

# Destinataire des notifications de nouvelle commande côté boutique.
ADMIN_EMAIL=admin@artiva.local
