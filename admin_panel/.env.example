# =============================================================================
# ARTIVA — Panel admin : configuration de DÉVELOPPEMENT LOCAL
# =============================================================================
# Create React App n'expose que les variables préfixées par REACT_APP_ et ne les
# relit qu'au démarrage : relancer `npm start` après toute modification ici.
# =============================================================================

# -----------------------------------------------------------------------------
# Adresse de l'API
# -----------------------------------------------------------------------------
# Laissée VOLONTAIREMENT vide : sans elle, src/config.js déduit l'adresse de
# l'API de celle par laquelle le panel est consulté. Ouvert sur
# http://localhost:3000 il appelle localhost:3001 ; ouvert depuis un autre PC sur
# http://192.168.137.190:3000 il appelle 192.168.137.190:3001. Aucun réglage à
# changer selon la machine.
#
# À ne renseigner QUE si le panel et le backend tournent sur deux machines
# différentes :
# REACT_APP_API_URL=http://192.168.137.190:3001/api

# --- PRODUCTION : pour tester le panel local contre le serveur déployé --------
# REACT_APP_API_URL=https://back-end-purple-log-1280.fly.dev/api

# -----------------------------------------------------------------------------
# Serveur de développement
# -----------------------------------------------------------------------------
# Le panel tourne sur le port 3000 ; 3001 est déjà pris par le backend.
PORT=3000

# Écoute sur toutes les interfaces réseau, pour que le panel soit accessible
# depuis un autre PC du réseau et pas seulement en local.
HOST=0.0.0.0
